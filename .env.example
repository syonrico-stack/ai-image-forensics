# ============ 服务配置 ============
# 监听地址：127.0.0.1=仅本机（单机模式）；0.0.0.0=局域网/Tailscale 可访问（服务器模式）
BIND_HOST=0.0.0.0
PORT=8000
# 数据目录（报告存储位置），默认 ./data
# DATA_DIR=./data

# ============ 在线检测层（全部可选，不配则自动跳过）============
# HuggingFace Inference API（开源检测模型，免费）
# 1=启用（默认） 0=禁用
ENABLE_HF=1
# 可选：免费注册 huggingface.co 获取 token，可显著提升免费额度
# HF_TOKEN=hf_xxxxxxxx
# 国内网络建议取消下行注释，走镜像站
# HF_ENDPOINT=https://hf-mirror.com
# 可选：自定义要投票的模型，逗号分隔
# HF_MODELS=Organika/sdxl-detector,umm-maybe/AI-image-detector

# Sightengine（https://sightengine.com 免费额度）
# SIGHTENGINE_USER=
# SIGHTENGINE_SECRET=

# Hive Moderation（https://thehive.ai 免费试用）
# HIVE_API_KEY=
